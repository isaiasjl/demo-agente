# copia este archivo a .env (no se sube a git). En local no hace falta nada

# modelo: claude (tu plan Pro, solo local) o foundry (Azure)
# sin MODEL_PROVIDER usa foundry si hay FOUNDRY_PROJECT_ENDPOINT, y claude si no
# MODEL_PROVIDER=claude

# Foundry
# FOUNDRY_PROJECT_ENDPOINT=https://<cuenta>.services.ai.azure.com/api/projects/<proyecto>
# FOUNDRY_MODEL=<nombre-del-despliegue>

# backend
# BACKEND_PORT=8088
# BACKEND_API_KEY=
# REQUIRE_API_KEY=true
# AGENT_TIMEOUT=90
# ENABLE_DOCS=true

# front (BACKEND_API_KEY tiene que ser la misma que la del backend)
# FRONT_PORT=3978
# BACKEND_URL=http://127.0.0.1:8088
# BACKEND_TIMEOUT=100
# MOSTRAR_HERRAMIENTAS=true

# Azure Bot, solo para Teams. En local se deja vacío
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
